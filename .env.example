# Copy to .env and fill in. None of these values ever reach the model.

# Your Anthropic key, used by the blueprint's runtime.
ANTHROPIC_API_KEY=

# The storefront, without a trailing slash.
MAGENTO_BASE_URL=https://demo.angeo.dev

# The store view code that appears in /rest/{store_code}/V1.
MAGENTO_STORE_CODE=default

# Integration access token: System > Extensions > Integrations in the admin.
# Needs read access to Catalog, Sales, Customers and CMS Pages, plus write
# access to Carts. Do not use an admin user token.
MAGENTO_ACCESS_TOKEN=

MAGENTO_CURRENCY=EUR

# Country used to estimate shipping when the session carries no address.
MAGENTO_ESTIMATE_COUNTRY=NL

# Set to 1 to have angeo/module-mcp-checkout issue a payment link for the quote
# instead of linking the storefront cart route.
MAGENTO_MCP_CHECKOUT_PAYLINK=0
